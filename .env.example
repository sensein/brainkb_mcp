# BrainKB MCP configuration.
# Copy to .env for LOCAL use (git-ignored). Never commit real credentials, and
# never bake credentials into a remote/production image (see README "Remote
# deployment" — use the per-user Authorization header there instead).

# Base URL of the query_service. From inside the container on Docker Desktop,
# the host machine is host.docker.internal.
BRAINKB_URL=http://host.docker.internal:8010

# usermanagement service (admin user/role/activation tools). Separate service with
# its own token. Defaults to BRAINKB_URL with :8010 -> :8004 if unset.
USERMANAGEMENT_URL=http://host.docker.internal:8004

# --- Auth ---
# A Personal Access Token (brainkb_pat_...) for browser-free login. Mint it with
# brainkb_create_token() after logging in once.
#
# LOCAL (stdio) ONLY. On the streamable-http remote this is IGNORED, because a
# caller who sends no credential of their own would silently act as this token's
# owner — the same identity-shadowing problem that got BRAINKB_EMAIL/PASSWORD
# auto-login removed. There is no email/password auto-login; do not add one.
# BRAINKB_TOKEN=brainkb_pat_...
#
# Opt back in ONLY for a deliberately single-user HTTP deployment:
# MCP_ALLOW_SHARED_IDENTITY=false

# --- Hosted-remote hardening ---
# Backends a caller may target via the X-BrainKB-Base-URL header or a tool's
# base_url argument. BRAINKB_URL is always allowed; anything else is refused,
# because the base URL is where credentials (bearer token, PAT, stored password)
# get sent — an arbitrary value is both SSRF and credential exfiltration.
# Comma-separated; pair each entry with its usermanagement URL as
# '<query-url>=<usermanagement-url>' where the :8010 -> :8004 convention doesn't
# apply — it never does for an https host. Loopback is additionally allowed under
# stdio for local dev.
#
# LEAVE IT UNSET when the MCP and the BrainKB stack share one host (the EC2
# layout above): BRAINKB_URL/USERMANAGEMENT_URL are then the only reachable
# backend, which is the tightest setting. Add an entry only for a SECOND backend
# you own — e.g. to let callers name the public prod route explicitly, or a
# staging stack:
# MCP_ALLOWED_BASE_URLS=https://queryservice.example.org=https://usermanagement.example.org
#
# Never list the MCP's own hostname (mcp.brainkb.org) — that is this server, not a
# backend, and pointing it at itself makes every credentialed call loop back in.

# IPs of the reverse proxy in front of the MCP. X-Forwarded-For is only believed
# from these peers (it is caller-supplied and forgeable, so trusting it from
# anyone lets a client mint a fresh identity per request and evade every rate
# limit — and pin a victim's IP to exhaust their quota). Comma-separated; each
# entry is an exact IP or a CIDR block. The MCP reads the RIGHTMOST
# X-Forwarded-For entry — what the trusted proxy itself observed.
#
# The value is the proxy's address AS THE CONTAINER SEES IT:
#   * ALB straight to this instance/task — the ALB's subnet CIDRs. Use CIDRs, not
#     IPs: ALB ENI addresses change when it scales, and a stale IP list silently
#     degrades to "all callers share one bucket".
#       aws ec2 describe-subnets --query 'Subnets[].CidrBlock' --output text \
#         --subnet-ids $(aws elbv2 describe-load-balancers --names <lb-name> \
#           --query 'LoadBalancers[0].AvailabilityZones[].SubnetId' --output text)
#   * nginx/Caddy on the HOST hitting the published 127.0.0.1:8080 — not the
#     proxy's own IP but the compose network gateway:
#       docker network inspect brainkb_mcp_default \
#         --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# A host-side proxy must also forward it:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;   (an ALB appends
# it automatically). Unparseable entries are reported at startup and NOT trusted.
MCP_TRUSTED_PROXIES=10.0.1.0/24,10.0.2.0/24

# Address the container's 8080 is published on. Default 127.0.0.1 (loopback) assumes
# the proxy runs on this host; an ALB forwarding to the instance cannot reach that,
# so set 0.0.0.0 there and allow TCP 8080 ONLY from the ALB's security group. This
# endpoint is plaintext and unauthenticated — Docker's iptables rules bypass host
# firewalls like ufw, so the security group is the real boundary.
# MCP_BIND_ADDR=0.0.0.0

# Directory that brainkb_ingest_files may read from. File paths resolve on the
# SERVER's filesystem, not the caller's, so file ingest is DISABLED on the
# streamable-http remote unless this is set. Leave it unset unless you want remote
# file ingest — this widens what the remote can do, it does not harden it.
#
# The path is INSIDE the container, so setting it also needs a matching bind mount
# in docker-compose.yml (see the commented `volumes:` entry there), and the host
# directory must be a dedicated upload dir holding nothing callers shouldn't be
# able to read back out via brainkb_read_space.
# MCP_INGEST_ROOT=/srv/brainkb-ingest

# --- Upload endpoint (POST /upload + brainkb_ingest_upload) --------------------
# The answer to "how do I ingest a 2.8 MB (or 5 GB) file through the remote?". MCP tool
# arguments are authored by the model, so anything routed through one has to be
# re-emitted token by token — unusable for a real file, and unsafe (dense Turtle does
# not survive transcription, and ingest is append-only). This endpoint gives the
# bytes their own path: the CLIENT streams the file from disk over HTTPS, the server
# stages it, and a tool ingests it by id. Nothing enters a context window.
#
#   import requests
#   requests.post("https://mcp.brainkb.org/upload",
#                 params={"filename": "review.ttl", "graph": "<graph_iri>"},
#                 headers={"Authorization": f"Bearer {TOKEN}"},
#                 data=open("review.ttl", "rb"))     # streamed off disk
#
# With `graph` set the server submits the ingest itself and answers 202 immediately —
# upload and forget; poll brainkb_upload_status(upload_id). Omit it to stage only.
#
# It is AUTHENTICATED (unlike / and /healthz): the same token path the tools use,
# plus a check that the caller holds the 'write' scope the ingest API requires. An
# upload is bound to the identity that made it and only that identity can ingest it.
# NOTE ON STYLE: no trailing `# comment` after a value anywhere in this file. When it
# is copied to .env and loaded through compose's `env_file`, the comment becomes part
# of the VALUE — a path gains ' # default: ...' and an integer stops parsing, which the
# server then silently replaces with its built-in default. Comments go above the line.
#
# On by default; set to false/0/no to turn the endpoint off.
MCP_UPLOAD_ENABLED=true
# The SERVER's default is <tmp>/brainkb-uploads; compose passes the path below. Either
# way it lives in the container's writable layer and is lost on redeploy — uncomment the
# matching `volumes:` entry in compose if a staged upload should survive a restart.
# Staged files are not ingested data: they are deleted once the ingest API accepts them.
MCP_UPLOAD_DIR=/var/lib/brainkb-uploads
# 5 GB per file, matching the ingest API's own per-user ceiling.
MCP_UPLOAD_MAX_BYTES=5000000000
# Across all staged uploads; a full staging area answers 507 rather than filling the disk.
MCP_UPLOAD_TOTAL_BYTES=20000000000
# Minutes before a staged, un-ingested upload is swept.
MCP_UPLOAD_TTL_MIN=360

# Transport (already set in the image / compose; override only if needed). The default
# is stdio — streamable-http is what makes this a hosted remote.
# MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- Rate limiting / abuse protection (per-caller by source IP; stdio exempt) ---
# In-process first line of defence — not a substitute for an edge WAF/gateway.
# Needs MCP_TRUSTED_PROXIES above to be right, or every caller behind the proxy
# shares one bucket. Counts are PER WINDOW (below), not per hour.
MCP_RATELIMIT_ENABLED=true
# SECONDS — length of the counting window.
MCP_RATELIMIT_WINDOW_SEC=60
# Logins per window (the brute-force ceiling).
MCP_RATELIMIT_AUTH_PER_MIN=8
# Mutations/ingest per window.
MCP_RATELIMIT_WRITE_PER_MIN=40
# Reads (search/sparql/provenance) per window.
MCP_RATELIMIT_READ_PER_MIN=120
# usermanagement admin calls per window.
MCP_RATELIMIT_ADMIN_PER_MIN=30
# Distinct callers tracked per window (memory cap).
MCP_RATELIMIT_MAX_KEYS=20000

# --- Session lifetime (logins are not forever) ---
# MINUTES, not days: 720 = 12 hours. Hard cap on how long the MCP keeps a cached
# in-session login. The real expiry is the refresh token's own
# (USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN on the server, default 12h) — whichever is
# sooner wins. When it lapses the MCP forgets the credentials and the user logs in
# again. Shorten it (e.g. 240 = 4h) to cut how long a hijacked session stays live;
# raising it above the server's refresh TTL has no effect.
MCP_SESSION_TTL_MIN=720

# --- Payload guards ---
# BYTES cap for brainkb_ingest_text (0 = unlimited). 10000000 = 10 MB.
MCP_MAX_INGEST_BYTES=10000000
# COUNT of files per brainkb_ingest_files call. File ingest is NOT byte-capped and
# streams large TTL/JSON-LD uploads (up to ~5GB/user); only the count is limited.
MCP_MAX_INGEST_FILES=50
