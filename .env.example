# BrainKB MCP configuration.
# Copy to .env for LOCAL use (git-ignored). Never commit real credentials, and
# never bake credentials into a remote/production image (see README "Remote
# deployment" — use the per-user Authorization header there instead).

# Base URL of the query_service. From inside the container on Docker Desktop,
# the host machine is host.docker.internal.
BRAINKB_URL=http://host.docker.internal:8010

# usermanagement service (admin user/role/activation tools). Separate service with
# its own token. Defaults to BRAINKB_URL with :8010 -> :8004 if unset.
USERMANAGEMENT_URL=http://host.docker.internal:8004

# --- Auth ---
# A Personal Access Token (brainkb_pat_...) for browser-free login. Mint it with
# brainkb_create_token() after logging in once.
#
# LOCAL (stdio) ONLY. On the streamable-http remote this is IGNORED, because a
# caller who sends no credential of their own would silently act as this token's
# owner — the same identity-shadowing problem that got BRAINKB_EMAIL/PASSWORD
# auto-login removed. There is no email/password auto-login; do not add one.
# BRAINKB_TOKEN=brainkb_pat_...
#
# Opt back in ONLY for a deliberately single-user HTTP deployment:
# MCP_ALLOW_SHARED_IDENTITY=false

# --- Hosted-remote hardening ---
# Backends a caller may target via the X-BrainKB-Base-URL header or a tool's
# base_url argument. BRAINKB_URL is always allowed; anything else is refused,
# because the base URL is where credentials (bearer token, PAT, stored password)
# get sent — an arbitrary value is both SSRF and credential exfiltration.
# Comma-separated; pair each entry with its usermanagement URL as
# '<query-url>=<usermanagement-url>' where the :8010 -> :8004 convention doesn't
# apply — it never does for an https host. Loopback is additionally allowed under
# stdio for local dev.
#
# LEAVE IT UNSET when the MCP and the BrainKB stack share one host (the EC2
# layout above): BRAINKB_URL/USERMANAGEMENT_URL are then the only reachable
# backend, which is the tightest setting. Add an entry only for a SECOND backend
# you own — e.g. to let callers name the public prod route explicitly, or a
# staging stack:
# MCP_ALLOWED_BASE_URLS=https://queryservice.brainkb.org=https://usermanagement.brainkb.org
#
# Never list the MCP's own hostname (mcp.brainkb.org) — that is this server, not a
# backend, and pointing it at itself makes every credentialed call loop back in.

# IPs of the reverse proxy in front of the MCP. X-Forwarded-For is only believed
# from these peers (it is caller-supplied and forgeable, so trusting it from
# anyone lets a client mint a fresh identity per request and evade every rate
# limit — and pin a victim's IP to exhaust their quota). Comma-separated.
#
# This must be the proxy's address AS THE CONTAINER SEES IT, which is usually NOT
# the proxy's own IP. With nginx/Caddy on the host talking to the published
# 127.0.0.1:8080, the container sees the compose network gateway — find it with:
#   docker network inspect brainkb_mcp_default \
#     --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Both common gateways are listed below; trim to the one you actually get. (With
# an ALB straight to ECS instead, use the ALB's ENI private IPs.)
MCP_TRUSTED_PROXIES=172.17.0.1,172.18.0.1

# Directory that brainkb_ingest_files may read from. File paths resolve on the
# SERVER's filesystem, not the caller's, so file ingest is DISABLED on the
# streamable-http remote unless this is set. Leave it unset unless you want remote
# file ingest — this widens what the remote can do, it does not harden it.
#
# The path is INSIDE the container, so setting it also needs a matching bind mount
# in docker-compose.yml (see the commented `volumes:` entry there), and the host
# directory must be a dedicated upload dir holding nothing callers shouldn't be
# able to read back out via brainkb_read_space.
# MCP_INGEST_ROOT=/srv/brainkb-ingest

# Transport (already set in the image / compose; override only if needed).
# MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- Rate limiting / abuse protection (per-caller by source IP; stdio exempt) ---
# In-process first line of defence — not a substitute for an edge WAF/gateway.
# Needs MCP_TRUSTED_PROXIES above to be right, or every caller behind the proxy
# shares one bucket. Counts are PER WINDOW (below), not per hour.
MCP_RATELIMIT_ENABLED=true
MCP_RATELIMIT_WINDOW_SEC=60       # SECONDS — length of the counting window
MCP_RATELIMIT_AUTH_PER_MIN=8      # logins per window (brute-force ceiling)
MCP_RATELIMIT_WRITE_PER_MIN=40    # mutations/ingest per window
MCP_RATELIMIT_READ_PER_MIN=120    # reads (search/sparql/provenance) per window
MCP_RATELIMIT_ADMIN_PER_MIN=30    # usermanagement admin calls per window
MCP_RATELIMIT_MAX_KEYS=20000      # distinct callers tracked per window (memory cap)

# --- Session lifetime (logins are not forever) ---
# MINUTES, not days: 720 = 12 hours. Hard cap on how long the MCP keeps a cached
# in-session login. The real expiry is the refresh token's own
# (USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN on the server, default 12h) — whichever is
# sooner wins. When it lapses the MCP forgets the credentials and the user logs in
# again. Shorten it (e.g. 240 = 4h) to cut how long a hijacked session stays live;
# raising it above the server's refresh TTL has no effect.
MCP_SESSION_TTL_MIN=720

# --- Payload guards ---
# BYTES cap for brainkb_ingest_text (0 = unlimited). 10000000 = 10 MB.
MCP_MAX_INGEST_BYTES=10000000
# COUNT of files per brainkb_ingest_files call. File ingest is NOT byte-capped and
# streams large TTL/JSON-LD uploads (up to ~5GB/user); only the count is limited.
MCP_MAX_INGEST_FILES=50
