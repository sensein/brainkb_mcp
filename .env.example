# BrainKB MCP configuration.
# Copy to .env for LOCAL use (git-ignored). Never commit real credentials, and
# never bake credentials into a remote/production image (see README "Remote
# deployment" — use the per-user Authorization header there instead).

# Base URL of the query_service. From inside the container on Docker Desktop,
# the host machine is host.docker.internal.
BRAINKB_URL=http://host.docker.internal:8010

# usermanagement service (admin user/role/activation tools). Separate service with
# its own token. Defaults to BRAINKB_URL with :8010 -> :8004 if unset.
USERMANAGEMENT_URL=http://host.docker.internal:8004

# --- Auth ---
# A Personal Access Token (brainkb_pat_...) for browser-free login. Mint it with
# brainkb_create_token() after logging in once.
#
# LOCAL (stdio) ONLY. On the streamable-http remote this is IGNORED, because a
# caller who sends no credential of their own would silently act as this token's
# owner — the same identity-shadowing problem that got BRAINKB_EMAIL/PASSWORD
# auto-login removed. There is no email/password auto-login; do not add one.
# BRAINKB_TOKEN=brainkb_pat_...
#
# Opt back in ONLY for a deliberately single-user HTTP deployment:
# MCP_ALLOW_SHARED_IDENTITY=false

# --- Hosted-remote hardening ---
# Backends a caller may target via the X-BrainKB-Base-URL header or a tool's
# base_url argument. BRAINKB_URL is always allowed; anything else is refused,
# because the base URL is where credentials (bearer token, PAT, stored password)
# get sent — an arbitrary value is both SSRF and credential exfiltration.
# Comma-separated; pair with a usermanagement URL where :8010 -> :8004 doesn't
# apply. Loopback is additionally allowed under stdio for local dev.
# MCP_ALLOWED_BASE_URLS=https://api.brainkb.org=https://users.brainkb.org

# IPs of the reverse proxy in front of the MCP. X-Forwarded-For is only believed
# from these peers (it is caller-supplied and forgeable, so trusting it from
# anyone lets a client mint a fresh identity per request and evade every rate
# limit — and pin a victim's IP to exhaust their quota).
# MCP_TRUSTED_PROXIES=10.0.1.10,10.0.2.10

# Directory that brainkb_ingest_files may read from. File paths resolve on the
# SERVER's filesystem, not the caller's, so file ingest is DISABLED on the
# streamable-http remote unless this is set. Point it at a dedicated upload
# directory holding nothing callers shouldn't be able to retrieve.
# MCP_INGEST_ROOT=/srv/brainkb-ingest

# Transport (set by the image already; override only if needed).
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# --- Rate limiting / abuse protection (per-caller by source IP; stdio exempt) ---
# In-process first line of defence — not a substitute for an edge WAF/gateway.
# MCP_RATELIMIT_ENABLED=true
# MCP_RATELIMIT_WINDOW_SEC=60
# MCP_RATELIMIT_AUTH_PER_MIN=8      # login (brute-force)
# MCP_RATELIMIT_WRITE_PER_MIN=40    # mutations/ingest
# MCP_RATELIMIT_READ_PER_MIN=120    # reads
# MCP_RATELIMIT_ADMIN_PER_MIN=30    # usermanagement admin
# MCP_RATELIMIT_MAX_KEYS=20000      # distinct callers tracked per window

# --- Session lifetime (logins are not forever) ---
# A cached login lasts until its refresh token expires
# (USERMANAGEMENT_REFRESH_TOKEN_TTL_MIN on the server), hard-capped here. When it
# lapses the MCP forgets the credentials and the user must log in again.
# MCP_SESSION_TTL_MIN=720

# --- Payload guards ---
# Raw-text ingest cap (0 = unlimited). File ingest is NOT byte-capped and streams
# large TTL/JSON-LD uploads (up to ~5GB/user); only the file COUNT is capped.
# MCP_MAX_INGEST_BYTES=10000000
# MCP_MAX_INGEST_FILES=50
