# BrainKB MCP configuration.
# Copy to .env for LOCAL use (git-ignored). Never commit real credentials, and
# never bake credentials into a remote/production image (see README "Remote
# deployment" — use the per-user Authorization header there instead).

# Base URL of the query_service. From inside the container on Docker Desktop,
# the host machine is host.docker.internal.
BRAINKB_URL=http://host.docker.internal:8010

# usermanagement service (admin user/role/activation tools). Separate service with
# its own token. Defaults to BRAINKB_URL with :8010 -> :8004 if unset.
USERMANAGEMENT_URL=http://host.docker.internal:8004

# Optional LOCAL auto-login (so you can skip the brainkb_login tool).
BRAINKB_EMAIL=you@example.com
BRAINKB_PASSWORD=change_me

# Transport (set by the image already; override only if needed).
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# --- Rate limiting / abuse protection (per-caller by source IP; stdio exempt) ---
# In-process first line of defence — not a substitute for an edge WAF/gateway.
# MCP_RATELIMIT_ENABLED=true
# MCP_RATELIMIT_WINDOW_SEC=60
# MCP_RATELIMIT_AUTH_PER_MIN=8      # register/login (brute-force)
# MCP_RATELIMIT_WRITE_PER_MIN=40    # mutations/ingest
# MCP_RATELIMIT_READ_PER_MIN=120    # reads
# MCP_RATELIMIT_ADMIN_PER_MIN=30    # usermanagement admin

# --- Payload guards ---
# Raw-text ingest cap (0 = unlimited). File ingest is NOT byte-capped and streams
# large TTL/JSON-LD uploads (up to ~5GB/user); only the file COUNT is capped.
# MCP_MAX_INGEST_BYTES=10000000
# MCP_MAX_INGEST_FILES=50
